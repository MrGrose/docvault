# Каталог репозитория (внутри появится .docvault/ и lmdb/)
DOCVAULT_REPO=./data/repo

# HMAC-секрет для capability-токенов (make demo-agent)
DOCVAULT_CAPABILITY_SECRET=

# Опционально: готовый токен для sandbox stub (scripts/demo_agent.sh выставляет сам)
# DOCVAULT_CAPABILITY_TOKEN=

# Опционально: стадия draft через LLM (template по умолчанию)
# DOCVAULT_LLM=openrouter
# DOCVAULT_LLM_MODEL=cohere/north-mini-code:free
# OPENROUTER_API_KEY=
# Опционально: bearer token для API. Пустое значение оставляет API открытым на localhost.
DOCVAULT_API_TOKEN=

# TTL идемпотентных ключей в секундах, 0 отключает истечение
DOCVAULT_IDEMPOTENCY_TTL=604800

# Ollama для стадии draft
# DOCVAULT_LLM=ollama
# DOCVAULT_OLLAMA_MODEL=llama3.2
# DOCVAULT_OLLAMA_URL=http://127.0.0.1:11434/api/generate
